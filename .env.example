APP_NAME=fabOS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=America/Bogota

# --- Laboratorio (configurable por instancia: fabOS es multi-lab) ---
LAB_NAME="Ean Fablab"
LAB_SHORT_NAME="Ean Fablab"
LAB_TIMEZONE=America/Bogota
LAB_CURRENCY_CODE=FBC
LAB_CURRENCY_NAME=FabCoin

# --- Ingreso por codigo de un solo uso (OTP) ---
# Captcha de Cloudflare (Turnstile) delante de todo formulario publico que
# manda correo: ingreso, solicitud de proyecto, practicas y cotizacion.
#
# Se sacan en el panel de Cloudflare -> Turnstile, creando un sitio para este
# dominio. VACIAS, el captcha no se pinta y no estorba: asi una instalacion
# nueva arranca sin obligar a tener cuenta de Cloudflare.
#
# La del sitio es publica y va en el HTML; la secreta no sale del servidor.
# Ilustraciones del catalogo generadas con Gemini. Se saca en Google AI
# Studio. VACIA, el boton no aparece y el catalogo sigue igual.
#
# Lo que genera NUNCA se presenta como foto: va a su propia columna y se
# enseña marcado como ilustracion, y desaparece en cuanto hay una foto real.
GEMINI_API_KEY=

# IA de texto (Claude): borradores de respuesta, guia de reservas y Activo IA.
# Se saca en console.anthropic.com. VACIA, todo eso se apaga y el resto del
# sistema sigue igual.
ANTHROPIC_API_KEY=

# Activo IA: lee fotos de equipos e insumos y propone cambios al inventario.
# Nunca guarda sin que una persona confirme. El tope es por dia.
IA_INVENTARIO_ACTIVA=true
IA_INVENTARIO_MODELO=claude-opus-5-5
IA_INVENTARIO_ESFUERZO=medium
IA_INVENTARIO_MAX_POR_DIA=100

# Servidor de IA del FabLab: reconoce objetos por foto para Activo IA. Las
# fotos no salen del laboratorio. Desde la red del FabLab no pide clave; desde
# fuera: FABLAB_IA_URL=https://ia.fablabean.com y FABLAB_IA_CLAVE=<clave>.
# Si el contenedor no resuelve el nombre .local, poner la IP del servidor.
FABLAB_IA_URL=http://spark-885a.local:11434
FABLAB_IA_CLAVE=
# Opcionales. El modelo que mira las fotos; si se cambia por uno más grande en
# el servidor, nombra mejor los objetos.
# FABLAB_IA_MODELO_VISION=qwen3.5:9b
# Primero se revisa qué es un objeto y después se busca en el inventario.
# FABLAB_IA_FILTRO_DE_OBJETOS=true
# Cuántos objetos se buscan como mucho en una foto.
# FABLAB_IA_MAX_OBJETOS=16

# Texto a voz del FabLab, para los anuncios con voz. Solo desde la red del
# laboratorio. Si el contenedor no resuelve el nombre .local, poner la IP del
# servidor (cambia: preguntarla).
FABLAB_VOZ_URL=http://spark-885a.local:8880

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_THROTTLE_PER_EMAIL=3
OTP_THROTTLE_WINDOW_MINUTES=15
OTP_REMEMBER_DAYS=30

# --- Dominios ---
# Dominio de identidad: quien pertenece a la Universidad
# Dominio de correo de la institucion. Quien entre con un correo de este
# dominio se registra como estudiante; el resto, como externo. Vacio =
# nadie es institucional.
INSTITUTIONAL_EMAIL_DOMAIN=
# Verificacion por carnet digital EAN (Â§5). Vacio = deshabilitado.
# Integracion con el carnet digital, propia de cada institucion. Vacio = no
# se usa, y el ingreso va solo por codigo al correo.
CARNET_EAN_BASE_URL=
CARNET_EAN_ENABLED=false
CARNET_EAN_TIMEOUT=5

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

# En Linux/macOS Sail toma estos valores del usuario del sistema; en Windows
# hay que fijarlos o la construccion de la imagen falla en groupadd.
WWWGROUP=1000
WWWUSER=1000

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=fabos
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo. En produccion, 'postmark' habla con la API por HTTPS; 'smtp' exige el
# puerto 587 abierto hacia fuera, que muchas redes institucionales bloquean.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
# En local, Mailpit captura todo el correo: http://localhost:8025
# En produccion se cambia MAIL_MAILER al proveedor transaccional; el remitente
# vive aqui como parametro para poder migrar al correo institucional sin tocar codigo.
# Token de servidor de Postmark, solo si MAIL_MAILER=postmark.
POSTMARK_API_KEY=

MAIL_FROM_ADDRESS="no-reply@ejemplo.org"
MAIL_FROM_NAME="${LAB_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Tunel Cloudflare (opcional) ---
CLOUDFLARE_TUNNEL_TOKEN=

# Proyectos por encargo (§11)
# Dias de anticipacion que necesita un encargo de un area de la propia
# institucion: su traslado presupuestal pasa por cuatro manos antes de que
# llegue un peso.
PROYECTO_DIAS_MINIMOS_INTERNO=15
# El formulario de pedido con que arranca ese traslado. Propio de cada
# institucion; en blanco, el aviso sale sin el enlace.
PROYECTO_FORMULARIO_VENTA_INTERNA=

# Banco de contenido (§21)
# El texto de la autorizacion se versiona: lo que alguien acepto en marzo tiene
# que seguir siendo consultable en diciembre. Al cambiar el texto, sube la
# version; nunca edites una version ya publicada.
CONTENIDO_TERMINOS_VERSION=2026-08
# Tope por archivo. No lo decide el gusto: el tunel de Cloudflare corta
# cualquier peticion de mas de 100 MB en el plan gratuito, asi que por encima
# de eso las subidas fallarian al final y sin explicacion.
CONTENIDO_MAX_MB=90
