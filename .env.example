APP_NAME=fabOS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=America/Bogota

# --- Laboratorio (configurable por instancia: fabOS es multi-lab) ---
LAB_NAME="Ean Fablab"
LAB_SHORT_NAME="Ean Fablab"
LAB_TIMEZONE=America/Bogota
LAB_CURRENCY_CODE=FBC
LAB_CURRENCY_NAME=FabCoin

# --- Ingreso por codigo de un solo uso (OTP) ---
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_THROTTLE_PER_EMAIL=3
OTP_THROTTLE_WINDOW_MINUTES=15
OTP_REMEMBER_DAYS=30

# --- Dominios ---
# Dominio de identidad: quien pertenece a la Universidad
# Dominio de correo de la institucion. Quien entre con un correo de este
# dominio se registra como estudiante; el resto, como externo. Vacio =
# nadie es institucional.
INSTITUTIONAL_EMAIL_DOMAIN=
# Verificacion por carnet digital EAN (Â§5). Vacio = deshabilitado.
# Integracion con el carnet digital, propia de cada institucion. Vacio = no
# se usa, y el ingreso va solo por codigo al correo.
CARNET_EAN_BASE_URL=
CARNET_EAN_ENABLED=false
CARNET_EAN_TIMEOUT=5

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

# En Linux/macOS Sail toma estos valores del usuario del sistema; en Windows
# hay que fijarlos o la construccion de la imagen falla en groupadd.
WWWGROUP=1000
WWWUSER=1000

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=fabos
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo. En produccion, 'postmark' habla con la API por HTTPS; 'smtp' exige el
# puerto 587 abierto hacia fuera, que muchas redes institucionales bloquean.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
# En local, Mailpit captura todo el correo: http://localhost:8025
# En produccion se cambia MAIL_MAILER al proveedor transaccional; el remitente
# vive aqui como parametro para poder migrar al correo institucional sin tocar codigo.
# Token de servidor de Postmark, solo si MAIL_MAILER=postmark.
POSTMARK_API_KEY=

MAIL_FROM_ADDRESS="no-reply@ejemplo.org"
MAIL_FROM_NAME="${LAB_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Tunel Cloudflare (opcional) ---
CLOUDFLARE_TUNNEL_TOKEN=
